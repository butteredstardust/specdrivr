FROM mcr.microsoft.com/playwright:v1.41.0-jammy

# Install pnpm
RUN npm install -g pnpm@9

# Set working directory
WORKDIR /app

# The source code will be mounted as a volume
# But we pre-copy package.json to cache layers if needed
# (Though for simulation we usually mount everything)

# Environment defaults
ENV CI=true
ENV NODE_ENV=test

# Just keep the container alive if needed, or override with command
CMD ["tail", "-f", "/dev/null"]
