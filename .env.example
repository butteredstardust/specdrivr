# Specdrivr Environment Configuration
# Copy this file to .env.local and fill in the required values.
# DO NOT commit .env.local - it's in .gitignore.

# ============================================
# Required: Core Application Secrets
# ============================================
# Generate strong, random secrets (minimum 32 characters)
# These are critical for authentication and encryption.
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
CRON_SECRET=your-cron-secret-min-32-chars

# ============================================
# Required: Database
# ============================================
# PostgreSQL connection URL
# Format: postgresql://username:password@localhost:5432/database
DATABASE_URL=postgresql://specdrivr:your_password@localhost:5432/specdrivr

# ============================================
# Required: Email (Resend)
# ============================================
# API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here
# From email address (must be verified with Resend)
RESEND_FROM_EMAIL=noreply@specdrivr.dev

# ============================================
# Optional: External Services
# ============================================
# GitHub Integration (for GitHub App functionality)
# Create a GitHub token with appropriate permissions
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ============================================
# Optional: Redis
# ============================================
# Redis connection URL for caching, rate limiting, and background jobs
# Default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================
# Environment Settings
# ============================================
# Node environment: development, production, or test
# Defaults to development if not set
NODE_ENV=development

# ============================================
# URLs
# ============================================
# NextAuth.js callback URL (your app's base URL)
# Default: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Public app URL (exposed to browser)
# Defaults to NEXTAUTH_URL if not set
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Security Notes
# ============================================
# - Never share these secrets or commit them to version control
# - Use different values for production environments
# - Rotate secrets regularly in production
# - For production, use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
#
# For Vitest test runs, dummy values will be auto-generated for required
# secrets if not provided.
#
# After editing this file, copy it to .env.local:
#   cp .env.example .env.local
