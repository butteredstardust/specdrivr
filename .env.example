# Environment
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
BETTER_AUTH_SECRET=example-secret-must-be-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# DATABASE_URL=postgresql://user:password@localhost:5432/specdrivr
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/specdrivr"

# Redis
REDIS_URL=redis://localhost:6379

# Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Agent Configuration
AGENT_BACKEND=gemini # 'gemini' or 'claude'

# Security
CRON_SECRET=your_32_char_minimum_secret_here
AGENT_TOKEN=sdk_your_agent_token_here

# GitHub Integration
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Resend Email Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@specdrivr.dev
