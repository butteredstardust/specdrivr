FROM ubuntu:22.04

# Install minimal dependencies needed for snapshot.sh
# We'll only install curl and sudo initially; snapshot.sh should handle the rest
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    ca-certificates \
    curl \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user with sudo access (simulates a realistic environment)
RUN useradd -m -s /bin/bash specdrivr && \
    echo "specdrivr ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER specdrivr
WORKDIR /home/specdrivr

# Copy project files (respecting .dockerignore - node_modules will be excluded)
COPY --chown=specdrivr:specdrivr . .

# Ensure snapshot.sh is executable
RUN chmod +x snapshot.sh

# Run snapshot.sh
CMD ["./snapshot.sh"]
