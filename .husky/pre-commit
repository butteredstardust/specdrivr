#!/bin/sh
# .husky/pre-commit
# Minimal orchestrator entry point
# DO NOT bypass: Enforcement logic is modularized in scripts/hooks/

set -e

# Use absolute path to the orchestrator
HOOK_PATH="$(git rev-parse --show-toplevel)/scripts/hooks/precommit.sh"

if [ -f "$HOOK_PATH" ]; then
  # Explicitly call bash for the modular orchestrator
  exec bash "$HOOK_PATH" "$@"
else
  echo "❌ Error: Modular hook orchestrator not found at $HOOK_PATH"
  exit 1
fi
