#!/bin/sh
set -e

echo "Checking code quality before push..."
echo ""

# 1. Branch Name Enforcement
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
  echo "Error: Direct pushes to main/master are prohibited. Use a feature branch."
  exit 1
fi

if ! echo "$current_branch" | grep -qE "^(feature|bugfix|refactor|docs|test|chore)/"; then
  echo "Error: Branch name '$current_branch' must follow prefix conventions (feature/, bugfix/, refactor/, etc.)."
  exit 1
fi

# 2. Conventional Commits Validation (Always check the last commit)
commit_msg=$(git log -1 --pretty=%B)
if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|merge)(\(.+\))?: .+$"; then
  echo "Error: Last commit message does not follow Conventional Commits format."
  echo "Format: <type>(<scope>): <subject> (e.g., feat(auth): add JWT support)"
  exit 1
fi

# 3. Identify files changed in the last commit (or staged changes)
# This ensures we catch issues even if the user already committed.
changed_files=$(git diff --name-only HEAD~1 HEAD)
# If there are staged (uncommitted) changes, include them too
staged_files=$(git diff --cached --name-only)
all_changed_files=$(echo "$changed_files\n$staged_files" | sort -u | grep -v "^$" || true)

if [ -z "$all_changed_files" ]; then
  echo "No changes detected in the last commit or staged area."
  exit 0
fi

# 4. Identify non-documentation files
non_md_files=$(echo "$all_changed_files" | grep -v "\.md$" || true)

# 5. Forbidden Scripts
if [ -f "fix-tsc.sh" ] || [ -f "fix-lint2.sh" ] || ls fix-*.mjs 1> /dev/null 2>&1; then
  echo "Error: Temporary fix scripts found. Remove before pushing."
  exit 1
fi

# 6. Check for modified migration files
if echo "$all_changed_files" | grep -q "^drizzle/.*\.sql$"; then
  echo "Error: Migration files cannot be modified. Run 'pnpm db:generate' instead."
  exit 1
fi

# 7. Check for .env files
if echo "$all_changed_files" | grep -q "\.env"; then
  echo "Error: Environment files cannot be committed."
  exit 1
fi

# 8. Check for .log files
if echo "$all_changed_files" | grep -q "\.log$"; then
  echo "Error: Log files cannot be committed."
  exit 1
fi

# 9. Conflict Marker Detection
if git diff HEAD~1 HEAD | grep -qE "^(\+|-| )*([<]{7}|[=]{7}|[>]{7})"; then
  echo "Error: Git conflict markers found in the last commit."
  exit 1
fi

# 10. Prohibited Patterns Scan
if git diff HEAD~1 HEAD | grep -v "^-" | grep -qE "(: any|process\.env)"; then
  if echo "$all_changed_files" | grep -qv "src/lib/env"; then
      echo "Error: Prohibited patterns found (any, process.env). Use Zod schemas and @/lib/env."
      exit 1
  fi
fi

tsx_files=$(echo "$all_changed_files" | grep "\.tsx$" || true)
if [ -n "$tsx_files" ]; then
  if echo "$tsx_files" | xargs grep -l "from '@/db'" 1>/dev/null 2>&1; then
    echo "Error: Direct DB imports found in UI components. Use repositories instead."
    exit 1
  fi
fi

# 11. Debug Code Check
if git diff HEAD~1 HEAD | grep -v "^-" | grep -qE "(console\.(log|debug|warn)|debugger)"; then
  echo "Error: Debug code found. Remove console logs and debugger statements."
  exit 1
fi

# 12. Selective Execution (Skip for Documentation)
if [ -z "$non_md_files" ]; then
  echo "Only documentation changes detected. Skipping full test suite..."
  echo "All checks passed (docs only)!"
  exit 0
fi

# 13. Heavy Checks (TypeScript, Lint, Test)
echo "Running full verification suite..."

# TypeScript type check
if ! pnpm tsc --noEmit > /dev/null 2>&1; then
  echo "Error: TypeScript type errors found."
  exit 1
fi

# ESLint
if ! pnpm lint > /dev/null 2>&1; then
  echo "Error: Linting failed."
  exit 1
fi

# Unit tests
if ! pnpm test:unit > /dev/null 2>&1; then
  echo "Error: Unit tests failed."
  exit 1
fi

echo "All checks passed!"
