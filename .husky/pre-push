#!/bin/sh
set -e

echo "Checking code quality before push..."
echo ""

# Check for forbidden scripts
if [ -f "fix-tsc.sh" ] || [ -f "fix-lint2.sh" ] || ls fix-*.mjs 1> /dev/null 2>&1; then
  echo "Error: Temporary fix scripts found. Remove before pushing."
  exit 1
fi

# Check for modified migration files
if git diff --cached --name-only | grep -q "^drizzle/.*\.sql$"; then
  echo "Error: Migration files cannot be modified. Run 'pnpm db:generate' instead."
  exit 1
fi

# Check for .env files
if git diff --cached --name-only | grep -q "\.env"; then
  echo "Error: Environment files cannot be committed."
  exit 1
fi

# Check for debug code
if git diff --cached | grep -qE "(console\.(log|debug|warn)|debugger)"; then
  echo "Error: Debug code found. Remove console logs and debugger statements."
  exit 1
fi

# TypeScript type check
if ! pnpm tsc --noEmit > /dev/null 2>&1; then
  echo "Error: TypeScript type errors found."
  exit 1
fi

# ESLint
if ! pnpm lint > /dev/null 2>&1; then
  echo "Error: Linting failed."
  exit 1
fi

# Unit tests
if ! pnpm test:unit > /dev/null 2>&1; then
  echo "Error: Unit tests failed."
  exit 1
fi

echo "All checks passed!"
