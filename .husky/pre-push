#!/usr/bin/env bash
# .husky/pre-push
set -euo pipefail

# ─── MANDATORY INSTRUCTION FOR AI AGENTS ──────────────────────────────────────
# DO NOT modify, disable, or delete this file to bypass check failures.
# If a push fails, the solution is almost certainly in the APPLICATION CODE.
# You are strictly prohibited from editing this script unless you have:
# 1. Performed a comprehensive Root Cause Analysis (RCA).
# 2. Determined with 100% confidence that the hook logic itself is broken.
# 3. Verified that the failing code is NOT violating a project mandate.
# Modifying this file to "just get it done" is a violation of system integrity.
#
# HOOK INTEGRITY VERIFICATION:
# This hook has checksum verification. If modified, the verify-hooks.js script
# will detect the change and warn on next push. CI also verifies hook integrity.
# After legitimate hook updates, run: node scripts/verify-hooks.js generate
# ──────────────────────────────────────────────────────────────────────────────

# ─── Environment Setup ────────────────────────────────────────────────────────
# Load local huskyrc if it exists (standard husky behavior for cross-platform env)
[ -f ~/.huskyrc ] && . ~/.huskyrc

# Add common Windows paths for Git and Node tools to PATH if on Windows
case "$(uname -s)" in
  MSYS*|MINGW*|CYGWIN*)
    # On Windows, we might need to add paths if they are not in the shell's PATH
    export PATH="$PATH:/c/Program Files/nodejs:/c/Program Files/Git/cmd"
    # Try to find npm global path for pnpm
    if command -v npm >/dev/null 2>&1; then
      NPM_GLOBAL_PATH=$(npm config get prefix 2>/dev/null | sed 's/\\/\//g' | sed 's/C:/\/c/')
      [ -n "$NPM_GLOBAL_PATH" ] && export PATH="$PATH:$NPM_GLOBAL_PATH"
    fi
    ;;
esac

echo "🔍 Running pre-push checks..."
echo ""

# ─── Configuration Bypass Detection ─────────────────────────────────────────────
earlier_git_bypass_warn() {
  echo ""
  echo "⚠️  WARNING: Git configuration suggests possible hook bypass attempt:"
  echo "   $1"
  echo ""
  echo "If you need to bypass hooks temporarily for troubleshooting,"
  echo "revert after debugging with:"
  echo "  git config --unset core.hooksPath"
  echo ""
  echo "Alternatively, use --no-verify which is logged but won Bitcoin silently bypass."
  echo ""
}

if git config --get core.hooksPath >/dev/null 2>&1; then
  hooks_path=$(git config --get core.hooksPath 2>/dev/null)
  if [ -n "$hooks_path" ] && [ "$hooks_path" != ".husky" ] && [ "$hooks_path" != ".husky/_" ]; then
    earlier_git_bypass_warn "core.hooksPath set to '$hooks_path' (hooks will still run now)"
  fi
fi

if git config --get init.templateDir >/dev/null 2>&1; then
  template_dir=$(git config --get init.templateDir 2>/dev/null)
  echo ""
  echo "⚠️  WARNING: init.templateDir is set to '$template_dir'"
  echo "   This could bypass hooks for new repositories."
  echo ""
fi

# ─── Self-Integrity Check ─────────────────────────────────────────────────────
# Verify this hook has not been modified (checks using Node script)
if command -v node >/dev/null 2>&1 && [ -f "scripts/verify-hooks.js" ]; then
  echo "Verifying hook integrity..."
  if node scripts/verify-hooks.js verify >/dev/null 2>&1; then
    echo "✓ Hook integrity verified"
  else
    echo ""
    echo "⚠️  WARNING: This hook file appears to have been modified!"
    echo "If you made intentional changes to improve checks, that's good."
    echo "If you're trying to bypass checks, please reconsider."
    echo ""
    echo "To update checksums after legitimate changes:"
    echo "  node scripts/verify-hooks.js generate"
    echo ""
    # Don't fail the push here, just warn - the actual checks are still valuable
  fi
  echo ""
else
  echo "Note: Hook integrity verification not available"
  echo ""
fi

# ─── Helpers ──────────────────────────────────────────────────────────────────
die() {
  # Audit logging (failure)
  if command -v node >/dev/null 2>&1 && [ -f "scripts/audit-hooks.js" ]; then
    range_for_audit="${range:-$(git log --oneline --format=\"%h\" | head -10 | wc -l)}"
    commits_count=$(git log --oneline --format="%h" "$range_for_audit" 2>/dev/null | wc -l || echo unknown)
    files_changed=$(git diff --name-only "$range_for_audit" 2>/dev/null | wc -l || echo unknown)
    node scripts/audit-hooks.js pre-push "$(git config user.name || echo 'unknown')" "failed" "commits:$commits_count,files:$files_changed,branch:$current_branch" 2>/dev/null || true
  fi
  echo "❌ Error: $*" >&2
  # Log failure message to audit as additional detail
  if command -v node >/dev/null 2>&1 && [ -f "scripts/audit-hooks.js" ]; then
    echo "$*" | node -e "
      const msg = require('fs').readFileSync(0, 'utf-8').trim();
      const entry = { timestamp: new Date().toISOString(), failure_reason: msg };
      const fs = require('fs');
      const path = require('path');
      const auditFile = path.join('.husky', 'audit', 'pre-push-' + new Date().toISOString().split('T')[0] + '.log');
      fs.appendFileSync(auditFile, JSON.stringify(entry) + '\\n');
    " 2>/dev/null || true
  fi
  exit 1
}

# ─── 1. Branch Protection ─────────────────────────────────────────────────────
current_branch=$(git rev-parse --abbrev-ref HEAD)

# ─── Audit Logging (pre-checks) ───────────────────────────────────────────────
# Log push attempt before running checks
if command -v node >/dev/null 2>&1 && [ -f "scripts/audit-hooks.js" ]; then
  node scripts/audit-hooks.js pre-push "$(git config user.name || echo 'unknown')" "running" "commits:unknown,files:unknown,branch:$current_branch" 2>/dev/null || true
fi

for protected in main master develop staging; do
  [ "$current_branch" = "$protected" ] && \
    die "Direct pushes to '$protected' are prohibited. Use a feature branch."
done

if ! echo "$current_branch" | grep -qE "^(feature|bugfix|refactor|docs|test|chore|hotfix|release)/[a-z0-9_-]+$"; then
  die "Branch '$current_branch' must follow: <type>/kebab-or-snake-case\nAllowed types: feature|bugfix|refactor|docs|test|chore|hotfix|release"
fi

# ─── 2. Resolve push range from stdin ─────────────────────────────────────────
# Pre-push receives: <local_ref> <local_sha> <remote_ref> <remote_sha>
NULL_SHA="0000000000000000000000000000000000000000"
range=""

while IFS=' ' read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$NULL_SHA" ] && continue  # branch deletion

  if [ "$remote_sha" = "$NULL_SHA" ]; then
    # New branch: diff from merge-base with main/master
    base=$(git merge-base HEAD \
      "$(git rev-parse --verify origin/main 2>/dev/null \
         || git rev-parse --verify origin/master 2>/dev/null \
         || echo "")" 2>/dev/null || true)
    range="${base:+${base}..}${local_sha}"
  else
    range="${remote_sha}..${local_sha}"
  fi
done

# Fallback for dry-run / local testing
[ -z "$range" ] && range="HEAD~1..HEAD"

changed_files=$(git diff --name-only "$range" 2>/dev/null || true)
changed_diff=$(git diff "$range" 2>/dev/null || true)

if [ -z "$changed_files" ]; then
  echo "No changes to verify."
  exit 0
fi

# ─── 3. Forbidden Artifacts ───────────────────────────────────────────────────
for script in fix-tsc.sh fix-lint2.sh; do
  [ -f "$script" ] && die "Temporary script '$script' found. Remove before pushing."
done

# Block other package manager lockfiles
for lock in package-lock.json yarn.lock; do
  [ -f "$lock" ] && die "Forbidden lockfile '$lock' found. This project uses pnpm exclusively."
done

fix_scripts=$(find . -maxdepth 1 -name "fix-*.mjs" ! -path "./.git/*" 2>/dev/null || true)
[ -n "$fix_scripts" ] && die "Temporary fix scripts found:\n$fix_scripts"

# ─── 4. Protected File Checks ─────────────────────────────────────────────────
echo "$changed_files" | grep -qE "^drizzle/.*\.sql$" && \
  die "Migration files cannot be modified. Run 'pnpm db:generate' to create new migrations."

echo "$changed_files" | grep -q "next-env\.d\.ts" && \
  die "next-env.d.ts is auto-generated by Next.js. Do not modify manually."

# Lockfile consistency: package.json changed but lockfile not updated
if echo "$changed_files" | grep -q "package\.json" \
   && ! echo "$changed_files" | grep -q "pnpm-lock\.yaml"; then
  die "package.json changed without updating pnpm-lock.yaml. Run 'pnpm install'."
fi

# ─── 5. Sensitive File Detection ──────────────────────────────────────────────
echo "$changed_files" | grep -v "\.env\.example" | grep -qE "(^|/)\.env(\.[a-z]+)?$" && \
  die "Environment files cannot be committed. Verify your .gitignore."

echo "$changed_files" | grep -q "\.log$" && \
  die "Log files cannot be committed."

# ─── 6. Secret / Credential Scan ──────────────────────────────────────────────
SECRET_PATTERN='(sk-[a-zA-Z0-9]{32,}|ghp_[a-zA-Z0-9]{36}|AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA|EC|OPENSSH) PRIVATE KEY)'
if echo "$changed_diff" | grep "^+" | grep -v "^+++" | grep -qE "$SECRET_PATTERN"; then
  die "Potential secret or API key detected. Audit, revoke, and rotate any exposed credentials."
fi

# ─── 7. Conflict Marker Detection ─────────────────────────────────────────────
if echo "$changed_diff" | grep -qE "^\+(<{7}|={7}|>{7})"; then
  die "Git conflict markers found in pushed changes."
fi

# ─── 8. Prohibited Code Patterns ─────────────────────────────────────────────
additions=$(echo "$changed_diff" | grep "^+" | grep -v "^+++")

# TypeScript `any` — only flag typed usages, not legitimate word matches
if echo "$additions" | grep -qE ": any(\b|,|\)|;|\s)"; then
  die "TypeScript 'any' type found. Use proper types or 'unknown' with type narrowing."
fi

# process.env outside the validated env module
if echo "$additions" | grep -q "process\.env"; then
  # Only flag files that actually added process.env AND are not in the allowed list
  env_violators=$(echo "$changed_diff" | awk '/^diff --git/ {file=$0; sub(/^diff --git a\/.* b\//, "", file)} /^(\+)([^+]|$)/ && /process\.env/ {print file}' | sort -u | grep -vE "src/lib/env|\.config\.(js|ts|mjs)|\.d\.ts|scripts/" || true)
  [ -n "$env_violators" ] && \
    die "process.env found outside @/lib/env. Use the Zod-validated env schema in:\n$env_violators"
fi

# Direct DB imports in UI components (both quote styles) - Strict legacy rule
# Mandate: Repository Pattern (GEMINI.md §3)
tsx_files=$(echo "$changed_files" | grep "\.tsx$" || true)
# Filter for existing files only to prevent xargs errors on deleted files
existing_tsx=$(echo "$tsx_files" | while read -r f; do [ -f "$f" ] && echo "$f"; done || true)

if [ -n "$existing_tsx" ]; then
  db_violators=$(echo "$existing_tsx" \
    | xargs grep -lE "from ['\"]@/db['\"]" 2>/dev/null \
    | grep -vE "src/(lib|server|repositories|actions)/" || true)
  [ -n "$db_violators" ] && \
    die "Direct DB imports found in UI components or pages:\n$db_violators\nUse the Repository Pattern (src/repositories/) instead."
fi

# ─── 9. Specdrivr Architecture Guards ─────────────────────────────────────────
# Guard A: Server Action Directives & Auth
action_files=$(echo "$changed_files" | grep "src/actions/" || true)
for f in $action_files; do
  [ -f "$f" ] || continue
  if ! grep -q "'use server'" "$f"; then
    die "Server Action file '$f' is missing the 'use server' directive."
  fi
  if ! grep -q "auth()" "$f"; then
    die "Security Risk: Server Action file '$f' does not appear to call 'auth()'. All actions must verify session."
  fi
  if grep -q "throw new" "$f"; then
    die "Server Action file '$f' contains 'throw'. Actions must return { success: false, error } instead."
  fi
done

# Guard B: Repository executeQuery Wrapper
repo_files=$(echo "$changed_files" | grep "src/repositories/" || true)
for f in $repo_files; do
  [ -f "$f" ] || continue
  if ! grep -q "executeQuery" "$f"; then
    die "Repository '$f' must use the 'executeQuery' wrapper for all database operations."
  fi
done

# Guard C: Design System (No Hex Colors)
if echo "$additions" | grep -qE "#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})"; then
  color_violators=$(echo "$changed_diff" | awk '/^diff --git/ {file=$0; sub(/^diff --git a\/.* b\//, "", file)} /^(\+)([^+]|$)/ && /#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})/ {print file}' | sort -u | grep -vE "globals\.css|tailwind\.config|\.config\." || true)
  [ -n "$color_violators" ] && \
    die "Hardcoded hex colors found in:\n$color_violators\nUse Tailwind classes or CSS variables from globals.css instead."
fi

# Guard D: XSS Prevention (DOMPurify Requirement)
if echo "$additions" | grep -q "dangerouslySetInnerHTML"; then
  xss_violators=$(echo "$changed_diff" | awk '/^diff --git/ {file=$0; sub(/^diff --git a\/.* b\//, "", file)} /^(\+)([^+]|$)/ && /dangerouslySetInnerHTML/ {print file}' | sort -u || true)
  for f in $xss_violators; do
    if ! grep -qE "DOMPurify|isomorphic-dompurify" "$f"; then
      die "XSS Risk: '$f' uses dangerouslySetInnerHTML without DOMPurify sanitization."
    fi
  done
fi

# ─── 10. Specdrivr UI & Performance Guards ────────────────────────────────────
tsx_additions=$(echo "$changed_files" | grep "\.tsx$" || true)

for f in $tsx_additions; do
  [ -f "$f" ] || continue
  
  # Guard E: Next.js Optimized Media
  if grep -q "<img" "$f"; then
    die "Performance Risk: raw <img> tag found in '$f'. Use Next.js <Image /> from 'next/image' instead."
  fi

  # Guard F: Client-Side Repository Leak
  if grep -q "'use client'\|\"use client\"" "$f"; then
    if grep -q "@/repositories" "$f"; then
      die "Architectural Violation: Client Component '$f' cannot import from @/repositories. Use Server Components or Server Actions."
    fi
  fi

  # Guard G: Form Standards (Mandate: zod + react-hook-form)
  if grep -q "<form" "$f"; then
    if ! grep -q "react-hook-form" "$f"; then
      die "Project Mandate: Form found in '$f' must use 'react-hook-form' and 'zod' for validation."
    fi
  fi

  # Guard H: Design System Tiering (Avoid raw HTML for common primitives)
  # Only flag files outside the UI library itself
  if [[ ! "$f" =~ "src/components/ui/" ]]; then
    if grep -qE "<(button|input|select)" "$f"; then
      echo "⚠️  Warning: Raw HTML primitive (<button/input/select>) found in '$f'. Verify if a design system component from @/components/ui or @pxlkit exists."
    fi
  fi
done

# ─── 11. Debug Code & Logging Standards ───────────────────────────────────────
# Mandate: Use @/lib/logger (Pino) instead of console.log/warn
if echo "$additions" | grep -qE "console\.(log|debug|warn|table|dir)\s*\("; then
  log_violators=$(echo "$changed_diff" | awk '/^diff --git/ {file=$0; sub(/^diff --git a\/.* b\//, "", file)} /^(\+)([^+]|$)/ && /console\.(log|debug|warn|table|dir)/ {print file}' | sort -u | grep -vE "scripts/" || true)
  die "Forbidden logging found (use @/lib/logger instead):\n$log_violators"
fi

if echo "$additions" | grep -q "debug""ger"; then
  die "Debugger statement found. Remove before pushing."
fi

# ─── 10. Test Integrity ───────────────────────────────────────────────────────
test_files=$(echo "$changed_files" | grep -E "\.(test|spec)\.(ts|tsx)$" || true)
existing_tests=$(echo "$test_files" | while read -r f; do [ -f "$f" ] && echo "$f"; done || true)

if [ -n "$existing_tests" ]; then
  if echo "$existing_tests" | xargs grep -qE "(it|test|describe)\.(only|skip)\b" 2>/dev/null; then
    die "Focused or skipped tests (.only/.skip) found. Remove before pushing."
  fi
fi

# ─── 11. Large File Guard ─────────────────────────────────────────────────────
MAX_KB=500
MAX_BYTES=$((MAX_KB * 1024))
large_files=$(echo "$changed_files" | while IFS= read -r f; do
  [ -f "$f" ] || continue
  # Use wc -c for cross-platform size check (works on git bash / linux / mac)
  size_bytes=$(wc -c < "$f")
  if [ "$size_bytes" -gt "$MAX_BYTES" ]; then
    echo "  $f ($((size_bytes / 1024))KB)"
  fi
done)
[ -n "$large_files" ] && \
  die "Files exceeding ${MAX_KB}KB:\n$large_files\nUse Git LFS or remove generated assets."

# ─── 12. Conventional Commits (all pushed commits) ───────────────────────────
COMMIT_PATTERN="^(feat|feature|fix|bugfix|docs|style|refactor|perf|test|build|ci|chore|revert|merge)(\(.+\))?(!)?: .{1,100}$"
invalid_commits=""

while IFS= read -r sha; do
  msg=$(git log -1 --pretty=%s "$sha")
  if ! echo "$msg" | grep -qE "$COMMIT_PATTERN"; then
    invalid_commits="${invalid_commits}  $sha: $msg\n"
  fi
done < <(git log --pretty=format:"%H" "$range")

if [ -n "$invalid_commits" ]; then
  echo "❌ Error: Non-conforming commit messages:" >&2
  printf "%b" "$invalid_commits" >&2
  echo "Format: <type>(<scope>)[!]: <description>  (max 100 chars)" >&2
  echo "Breaking change suffix: feat(api)!: drop v1 endpoint" >&2
  exit 1
fi

# ─── 13. Docs-only shortcut ───────────────────────────────────────────────────
non_doc_files=$(echo "$changed_files" | grep -vE "\.(md|mdx|txt)$" || true)
if [ -z "$non_doc_files" ]; then
  echo "✅ Documentation-only push. Skipping build suite."
  exit 0
fi

# ─── 14. Build & Test Suite ───────────────────────────────────────────────────
echo "📦 Starting Build & Test Suite..."

echo "🏷️ Running TypeScript check..."
pnpm tsc --noEmit || die "TypeScript errors found. Run 'pnpm tsc --noEmit' for details."

echo "🔍 Running ESLint..."
pnpm lint || die "Linting failed. Run 'pnpm lint' for details."

echo "🧪 Running unit tests..."
pnpm test:unit || die "Unit tests failed. Run 'pnpm test:unit' for details."

echo ""
echo "✅ All pre-push checks passed!"

# Audit logging (success)
if command -v node >/dev/null 2>&1 && [ -f "scripts/audit-hooks.js" ]; then
  range_for_audit="${range:-$(git log --oneline --format=\"%h\" | head -10 | wc -l)}"
  commits_count=$(git log --oneline --format="%h" "$range_for_audit" 2>/dev/null | wc -l || echo unknown)
  files_changed=$(git diff --name-only "$range_for_audit" 2>/dev/null | wc -l || echo unknown)
  node scripts/audit-hooks.js pre-push "$(git config user.name || echo 'unknown')" "passed" "commits:$commits_count,files:$files_changed,branch:$current_branch" 2>/dev/null || true
fi