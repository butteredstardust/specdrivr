{
  "entry": [
    "src/app/**/route.ts",
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/error.tsx",
    "src/app/**/global-error.tsx",
    "src/app/**/not-found.tsx",
    "src/app/**/loading.tsx",
    "src/app/globals.css",
    "src/components/**/*.tsx",
    "src/actions/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.js",
    "drizzle.config.ts",
    "src/proxy.ts"
  ],
  "project": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "ignore": [
    "src/components/ui/daemon-mascot.tsx",
    "src/components/ui/**/*.tsx"
  ],
  "ignoreDependencies": [
    "@types/node",
    "@types/react",
    "@types/react-dom",
    "typescript",
    "eslint",
    "postcss",
    "tailwindcss",
    "autoprefixer",
    "eslint-config-next",
    "knip",
    "next-themes",
    "@pxlkit/social",
    "@pxlkit/effects",
    "@pxlkit/gamification",
    "@pxlkit/weather",
    "nanoid",
    "react-hook-form",
    "@hookform/resolvers",
    "husky"
  ],
  "ignoreBinaries": ["drizzle-kit", "better-auth"]
}
