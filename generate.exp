#!/usr/bin/expect -f
set timeout 10
spawn pnpm db:generate

expect {
    -re ".*renamed.*" {
        send "\r"
        exp_continue
    }
    -re ".*created.*" {
        send "\r"
        exp_continue
    }
    -re ".*delete.*" {
        send "\r"
        exp_continue
    }
    -re ".*\\?.*" {
        send "\r"
        exp_continue
    }
    eof
}
